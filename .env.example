# ====================================================================
# AI Stock Market Research Assistant - Environment Variables Configuration
# Copy this file to .env and fill in your values
# ====================================================================

# Google Gemini API Key for Agent Chat
GEMINI_API_KEY=your_gemini_api_key_here

# Lakebase / Postgres URL (Format: postgresql://username:password@host:port/database)
# If left blank, the app will automatically run on a local SQLite database fallback.
LAKEBASE_URL=

# Massive Stocks API Key (If you have one, otherwise runs in sandbox/mock mode)
MASSIVE_STOCKS_API_KEY=

# Optional: Individual Postgres Connection Keys
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
